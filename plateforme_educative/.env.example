# Django settings
DJANGO_SECRET_KEY=django-insecure-example-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
DB_ENGINE=mysql
DB_NAME=rag_platform1
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Email Configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend # Décommentez pour envoyer de vrais mails en dev
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@gmail.com

# LLM Configuration
GROQ_API_KEY=
OPENAI_API_KEY=

# Mode hors-ligne (Ollama local) — utilisé automatiquement si aucune connexion
# internet n'est détectée (ou si aucune clé Groq/OpenAI n'est définie).
# Qwen2.5 1.5B Instruct : rapide sur CPU (~2-4s/appel) et fiable en JSON structuré.
# Pré-requis : `ollama pull qwen2.5:1.5b-instruct`
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_CTX=4096

# Celery / Redis (TASK_ALWAYS_EAGER=True si DJANGO_DEBUG=True, Redis non requis en dev)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Boîte de réception satellite (carrousel FLUTE).
# Pointez le récepteur multicast dessus :  python carrousel_client.py --output <ce dossier>
# Le tableau de bord admin y détecte les exports de cours et propose de les importer.
# Défaut : <media>/satellite_inbox
# SATELLITE_INBOX_DIR=/var/www/plateforme_educative/plateforme_educative/media/satellite_inbox
